# Copy to .env for local development (`npm run dev` loads it).
# Every integration falls back to a mock when its credentials are blank, so the
# whole app works locally with this file as-is.

PORT=8080
NODE_ENV=development
# development | staging | production. Hosts like Vercel force NODE_ENV=production,
# so APP_ENV decides: staging may run on mocks, production may not.
APP_ENV=development
# Public base URL of this API — used for checkout callback/return links.
PUBLIC_URL=http://localhost:8080
# 32+ random characters when deployed (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# Postgres connection string (Neon). Leave blank locally to use an embedded
# Postgres (PGlite) stored in PGLITE_DIR — nothing to install. Required when deployed;
# on Vercel use Neon's *pooled* URL.
DATABASE_URL=
PGLITE_DIR=./data/pglite
# Vercel Cron sends this to /internal/sweep (payment reconciliation).
CRON_SECRET=
# Origins allowed to call the API from a browser (the website, which includes /admin),
# comma-separated, or * for any.
CORS_ORIGINS=

# --- Admin dashboard & website ---------------------------------------------
# First admin-dashboard owner account, created on boot when no staff exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=smeter admin
# Optionally serve the static website (/, with the admin dashboard at /admin) from the API.
SITE_DIR=

# --- Geni / Calin meter head-end -------------------------------------------
# Leave GENI_USER_ID/GENI_PASSWORD blank to use the built-in mock head-end.
GENI_BASE_URL=http://8.208.24.83:9200
GENI_COMPANY=Geni
GENI_USER_ID=
GENI_PASSWORD=
# Separate password the head-end requires to mint credit tokens.
GENI_AUTHORIZATION_PASSWORD=
# Response `code` values that mean success.
GENI_SUCCESS_CODES=0,200
# Remote-task settings are meter-firmware specific — confirm with the vendor.
GENI_PUSH_TOKENS_OTA=true
GENI_TOKEN_TASK_PROTOCOL_ID=0
GENI_DISCONNECT_PROTOCOL_ID=0
GENI_DISCONNECT_DATA=0
GENI_RECONNECT_PROTOCOL_ID=0
GENI_RECONNECT_DATA=1
# 'cumulative' (register readings) or 'interval' (energy per interval).
GENI_ENERGY_MODE=cumulative

# --- Payments (Paystack) -----------------------------------------------------
# Blank → local mock checkout at /pay/mock/:reference.
PAYSTACK_SECRET_KEY=
PAYMENT_CHANNELS=card,bank_transfer,ussd
PAYMENT_FEE_PERCENT=1.5
PAYMENT_FEE_FLAT_NAIRA=100
PAYMENT_FEE_FLAT_THRESHOLD_NAIRA=2500
PAYMENT_FEE_CAP_NAIRA=2000
MIN_PURCHASE_NAIRA=500
MAX_PURCHASE_NAIRA=500000
PAYMENT_AUDIT_AFTER_MINUTES=5

# --- Tariffs -------------------------------------------------------------------
# Regulatory ceiling on the landlord price per kWh, and the utility's base cost.
MAX_UNIT_PRICE_NAIRA=250
BASE_UNIT_COST_NAIRA=209.5

# --- Email (Resend): login codes, password resets, payout codes, tenant invites ---
# Blank → codes are printed to the server log instead of emailed.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "smeter <no-reply@smeter.ng>".
# Until a domain is verified, onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM=smeter <onboarding@resend.dev>
EMAIL_REPLY_TO=
OTP_TTL_MINUTES=5
# Include login codes in API responses (for testing). On by default in development; staging must
# opt in; never honoured when APP_ENV=production.
OTP_DEBUG_ECHO=true
