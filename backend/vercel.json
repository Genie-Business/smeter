{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "crons": [{ "path": "/internal/sweep", "schedule": "0 6 * * *" }],
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
